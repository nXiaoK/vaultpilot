# 运行节点 UID/GID，需要对备份源具有读取权限，对恢复目标具有写入权限。
VP_UID=1000
VP_GID=1000
VP_PORT=8080
VP_PUBLIC_URL=http://localhost:8080
# 可选自定义微软应用。默认 Rclone 标准授权无需填写以下三项。
VP_OAUTH_CLIENT_ID=
VP_OAUTH_CLIENT_SECRET=
VP_OAUTH_TENANT=consumers
# 替换成宿主机真实目录，不要挂载宿主机根目录。
VP_SOURCE_HOST=./example-data/source
# 自定义目录必须提前创建并允许 VP_UID/VP_GID 写入，网页目标使用 /restore 下的路径。
VP_RESTORE_HOST=./example-data/restore
VP_GLOBAL_CONCURRENCY=2
# 全局日志条数与缓存阈值；缓存检查发生在任务阶段边界，不是文件系统硬配额。
VP_LOG_MAX_ROWS=100000
VP_CACHE_MAX_BYTES=21474836480
# 清理、检查与迁移允许时间，留空允许全天；支持跨午夜，如 23:00-05:00。
VP_MAINTENANCE_WINDOW=
VP_MAINTENANCE_TIMEZONE=Asia/Shanghai
# 自动解锁需要另外挂载 0600 的专用文件，并设置容器内路径。
VP_AUTO_UNLOCK_FILE=
